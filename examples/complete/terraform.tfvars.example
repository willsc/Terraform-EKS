aws_region         = "eu-west-2"
cluster_name       = "three-node-eks"
kubernetes_version = "1.36"

# Replace with your existing administrator IAM role or user ARN.
# Do not use an arn:aws:sts::...:assumed-role/... session ARN.
cluster_admin_principal_arns = ["arn:aws:iam::123456789012:role/EKSAdministrator"]

# Private mode: reach the API from a connected VPC/VPN management network.
node_subnet_type              = "private"
endpoint_public_access        = false
endpoint_private_access_cidrs = ["10.0.0.0/16"]
single_nat_gateway            = false

# For public API access, enable this and use your actual public egress IP/CIDR.
# endpoint_public_access       = true
# endpoint_public_access_cidrs = ["203.0.113.10/32"]

# Optional public workers (no NAT gateways):
# node_subnet_type = "public"
